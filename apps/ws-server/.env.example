# ─── Pipeline Mode ──────────────────────────────────────────
# "classic" = STT → LLM → TTS (default)
# "conversational_ai" = ElevenLabs all-in-one speech-to-speech
PIPELINE_MODE=classic

# ─── TTS Provider (classic mode only) ──────────────────────
TTS_PROVIDER=elevenlabs

# ─── ElevenLabs ─────────────────────────────────────────────
ELEVENLABS_API_KEY=sk_your_key_here

# Agent ID for conversational_ai mode (run: bun run src/setup-agent.ts)
ELEVENLABS_AGENT_ID=

# Voice IDs per language (default: Jessica — conversational, warm, bright)
ELEVENLABS_VOICE_EN=cgSgspJ2msm6clMCkdW9
ELEVENLABS_VOICE_DE=cgSgspJ2msm6clMCkdW9
ELEVENLABS_VOICE_ES=cgSgspJ2msm6clMCkdW9

# Model: eleven_flash_v2_5 — ~75ms latency, 32 languages
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5

# ─── Gradium (fallback TTS) ────────────────────────────────
GRADIUM_API_KEY=
GRADIUM_VOICE_ID=
GRADIUM_REGION=eu

# ─── LLM Provider ──────────────────────────────────────────
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GROQ_API_KEY=
